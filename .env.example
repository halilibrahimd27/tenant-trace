# Tenant credentials the prober authenticates with. Referenced by name from
# tenanttrace.toml ([auth] token_env) so the values never enter the config file.
TT_TOKEN_A=
TT_TOKEN_B=

# Only needed when the seeder talks to a database directly.
# TT_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/app
# TT_REDIS_URL=redis://127.0.0.1:6379/0
